{
  "name": "drawfree",
  "version": "0.1.0",
  "private": true,
  "description": "Storyboards you drag, not draw.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sheet": "tsx tools/sheet.ts art-sheet.png",
    "check": "node tools/check.js",
    "ci": "npm run typecheck && npm test && vite build && node tools/check.js",
    "deploy": "npm run build && node tools/check.js && wrangler deploy",
    "deploy:staging": "npm run build && node tools/check.js && wrangler deploy --env staging",
    "deploy:preview": "npm run build && node tools/check.js && wrangler versions upload --env staging"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "type": "module"
}
